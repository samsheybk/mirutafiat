# Copia este archivo a .env y ajusta los valores

# Puerto del servidor API
PORT=4000

# Interfaz donde escucha la API (M-4). Default 127.0.0.1 = SOLO esta maquina.
# El webmail consulta siempre http://localhost:4000, por lo que no hace falta
# cambiar esto salvo despliegues detras de un reverse proxy en otro host.
HOST=127.0.0.1

# Autenticacion de la API (obligatoria). Acepta "Authorization: Bearer <token>"
# (token de operaciones) o el access_token de la sesion Supabase, que se valida
# contra SUPABASE_URL/auth/v1/user. El frontend envía el token de sesión solo.
# Genera uno de operaciones con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_API_TOKEN=

# CORS: origenes permitidos separados por coma. Vacio = sin cross-origin (mismo origen).
CORS_ORIGIN=

# Validacion TLS en IMAP/SMTP: 1 = verificar el certificado (recomendado).
# 0 = desactivar la verificacion (solo si el servidor de correo usa cert auto-firmado).
TLS_REJECT_UNAUTHORIZED=1

# Clave para cifrar las contrasenas de cuentas en data/accounts.json (AES-256-GCM).
# Opcional: si no se define, las claves se guardan en texto plano (no recomendado).
ACCOUNTS_ENC_KEY=

# Tamaño maximo (MB) de cada adjunto al enviar
MAX_UPLOAD_MB=25

# Google OAuth ("Conectar con Gmail"). Crea un cliente OAuth 2.0 tipo "Web" en
# Google Cloud Console (console.cloud.google.com/apis/credentials) y añade
# GOOGLE_REDIRECT_URI como "URI de redireccionamiento autorizado".
# Necesita el alcance sensible https://mail.google.com/ -> la app aparecera como
# "no verificada" hasta pedir verificacion (en modo pruebas, usa "Acceso avanzado").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback
# Origenes validos para el "return" tras conectar (coma separada).
INTRANET_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Clave para firmar el state de OAuth (CSRF). Si se deja vacia se usa ACCOUNTS_ENC_KEY.
GOOGLE_STATE_SECRET=

# Notificaciones push (Web Push). Generadas con: npx web-push generate-vapid-keys --json
# VAPID_PUBLIC_KEY tambien debe estar en fiat-intranet/js/pwa.js (no es secreta).
# VAPID_SUBJECT debe ser un mailto: de contacto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@fiat-ve.com

# Aviso push de nuevos correos: el email-server consulta push_subscriptions
# en Supabase usando la clave de servicio (SERVICE_ROLE_KEY, NO compartir).
SUPABASE_URL=
SERVICE_ROLE_KEY=
# Cada cuantos segundos revisar el INBOX de las cuentas con dueno
MAIL_POLL_SECONDS=60
